# Copy to .env and fill in. Never commit .env.

# --- live GitHub target (the graded path) ---------------------------------
GITHUB_USERNAME=
GITHUB_PASSWORD=
# Base32 secret shown as "setup key" when enabling TOTP 2FA (spaces are
# fine).
GITHUB_TOTP_SECRET=
# Only for `make bootstrap` / `make clean-drafts` (setup; the automation
# itself is browser-only). Optional if `gh auth login` is done.
GITHUB_TOKEN=

# Encrypts state/<portal>__<credential>.json.enc.
# Generate: `uv run homing keygen`
SESSION_KEY=

# --- optional ---------------------------------------------------------------
# HEADED=true      # show the browser
# HOMING_HOME=.    # where state/ and runs/ live
# DBOS system DB; or postgresql://...
# HOMING_DB_URL=sqlite:///state/dbos.sqlite

# --- mock portal only (tests; GreenMail via docker compose) ----------------
ACME_USERNAME=demo
ACME_PASSWORD=demo-password
ACME_IMAP_USER=demo
ACME_IMAP_PASSWORD=secret
